# Public values only. Add in Netlify project environment variables, then redeploy.
# Locally: node --env-file=.env scripts/build-premium.mjs
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy public SUPABASE_ANON_KEY is accepted instead of the publishable key.
# NEVER use a service_role key, sb_secret key, SMTP password or personal token.
